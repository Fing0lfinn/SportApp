{
  "expo": {
    "name": "1 Year",
    "slug": "sportapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sportapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.fing0lfinn.sportapp",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fing0lfinn.sportapp"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#C8F04A"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "tr",
              "ja",
              "es",
              "de"
            ],
            "android": [
              "en",
              "tr",
              "ja",
              "es",
              "de"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0B0D10",
    "owner": "cptmirana",
    "extra": {
      "eas": {
        "projectId": "5add212d-cad7-4673-8cd1-8825fdb1d3a8"
      }
    },
    "locales": {
      "en": "./locales/en.json",
      "tr": "./locales/tr.json",
      "ja": "./locales/ja.json",
      "es": "./locales/es.json",
      "de": "./locales/de.json"
    }
  }
}
